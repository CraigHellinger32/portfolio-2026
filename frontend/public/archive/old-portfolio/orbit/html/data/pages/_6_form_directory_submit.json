{
    "bodyClass": "directory-submit-form",
    "breadcrumb": [
        {
            "title": "Directory article",
            "url": "3-directory-article.html"
        }
    ],
    "content": {
        "title": "Submit a record",
        "action": "6-form-directory-submit.html",
        "method": "get",
        "primaryAction": {
            "name": "submit",
            "label": "Submit"
        },
        "controls": [
            {
                "type": "select",
                "label": "Title",
                "name": "salutation",
                "options": [
                    {"value": "-1","text": "Select..."},{"value": "Mr","text": "Mr"},{"value": "Miss","text": "Miss"},{"value": "Mrs","text":"Mrs"},{"value": "Mrs","text":"Mrs"},{"value": "Ms","text":"Ms"},{"value": "Mx","text":"Mx"},{"value": "Dr","text":"Dr"}
                ],
                "mandatory": true
            },
            {
                "type": "text",
                "label": "Name",
                "name": "name"
            },
            {
                "type": "email",
                "label": "Email address",
                "name": "reg_email",
                "mandatory": true
            },
            {
                "type": "textarea",
                "label": "Description",
                "name": "description"
            },
            {
                "type": "google_map",
                "label": "Location",
                "name": "location",
                "value": "UK_GB",
                "id": "6",
                "help": "Note: Google maps will not actually load in this prototype.",
                "mandatory": true
            },
            {
                "type": "esri",
                "label": "Location",
                "name": "location-2",
                "help": "Note: Esri maps will not actually load in this prototype."
            },
            {
                "type": "file",
                "label": "File upload field",
                "name": "file_upload",
                "mandatory": true
            },
            {
                "type": "image_upload",
                "label": "Image upload field",
                "name": "image_upload",
                "mandatory": true
            }
        ]
    }
}
