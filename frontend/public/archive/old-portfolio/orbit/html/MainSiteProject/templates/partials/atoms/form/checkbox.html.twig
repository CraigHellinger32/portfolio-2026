{# REMEMBER to change the path to @theme:xfpbase if you have XFP installed #}
{% extends '@theme:base/partials/atoms/form/checkbox.html.twig' %}

{% block form_checkbox_inner %}

    {% block form_checkbox_input %}
        <input
            {% block form_checkbox_attributes %}
                class="form__checkbox"
                id="{{ name ~ loop.index }}"
                type="checkbox"
                name="{{ name ~ '[]' }}"
                value="{{ option.value }}"
                {% if help %}
                    aria-describedby="help_text_{{ id|default(name) }}"
                {% endif %}
                {% if option.value in value %} checked{% endif %}
                {% if option.data is not empty %} data-xfp="{{ option.data }}"{% endif %}
            {% endblock %}
        >
    {% endblock %}

    {% block form_checkbox_label %}
        {{ parent() }}
    {% endblock %}

{% endblock %}
