{% block breadcrumbs %}
    <nav class="breadcrumb" aria-label="Breadcrumb Navigation">
        <div class="container">

            {% block breadcrumbs_list -%}
                <ol class="list{{ className ? ' ' ~ className }}">

                    {%- block breadcrumbs_list_inner -%}
                        {% block breadcrumbs_home %}
                            <li class="list__item">
                                <a href="{{ path('index') }}" rel="home">
                                    {{ getTranslatedString('home-link-text') }}
                                </a>
                            </li>
                        {% endblock breadcrumbs_home %}

                        {% block breadcrumbs_link %}
                            {% for item in group %}

                                {% block breadcrumbs_link_inner %}
                                    <li class="list__item">
                                        <a href="{{ item.url }}">
                                            {{ item.title }}
                                        </a>
                                    </li>
                                {% endblock %}

                            {% endfor %}
                        {% endblock breadcrumbs_link %}

                        {% block breadcrumbs_current %}
                            <li class="list__item"><span>{{ title }}</span></li>
                        {% endblock %}
                    {%- endblock breadcrumbs_list_inner -%}

                </ol>
            {%- endblock breadcrumbs_list %}

        </div>
    </nav>
{% endblock breadcrumbs %}
