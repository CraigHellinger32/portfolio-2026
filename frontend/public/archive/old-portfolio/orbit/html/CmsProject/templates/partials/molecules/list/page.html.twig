{% if group %}
    {% set item_count = group|length %}
    {% set current_item = '' %}

    {% for item in group %}
        {% if item.active %}
            {% set current_item = loop.index %}
        {% endif %}
    {% endfor %}

    {% if current_item %}
        {% set pages_in_string = 'Page ' ~ current_item ~ ' / ' ~ item_count %}
    {% else %}
        {% set pages_in_string = item_count ~ ' Pages' %}
    {% endif %}

    {% block pages_in %}
        <nav class="nav nav--pages-in" aria-labelledby="a11y-pages-in-heading">

        {% block pages_in_inner %}
            {% block pages_in_heading %}
                <h2 class="nav__heading mobile-hidden" id="a11y-pages-in-heading">Contents</h2>
            {% endblock %}

            {% block pages_in_button %}
                <button class="button button--block button--secondary button--icon-right nav__toggle js-pages-in-toggle" data-a11y-toggle="pages-in-list">
                    <span class="nav__toggle-heading">Contents</span>

                    <span class="nav__toggle-pages">{{ pages_in_string }}</span>
                    <span class="nav__toggle-icon icon toggle-icon">
                        <span class="toggle-icon__line"></span>
                    </span>
                </button>
            {% endblock pages_in_button %}

            {% block pages_in_list %}
                <ol class="nav__list list list--numbered" id="pages-in-list">
                    {% for item in group %}
                        {% if item.active %}

                            {% block pages_in_active %}
                                <li class="list__item is-active">
                                    <span class="list__link">
                                        <strong class="visually-hidden">{{ getTranslatedString('you-are-here-marker') }}</strong>
                                        {{ item.title }}
                                    </span>
                                </li>
                            {% endblock %}

                        {% else %}

                            {% block pages_in_link %}
                                <li class="list__item">
                                    <a class="list__link" href="{{ item.url }}">
                                        <span class="list__link-text">{{ item.title }}</span>
                                    </a>
                                </li>
                            {% endblock %}

                        {% endif %}
                    {% endfor %}
                </ol>
            {% endblock pages_in_list %}
        {% endblock pages_in_inner %}

        </nav>
    {% endblock pages_in %}

{% endif %}
