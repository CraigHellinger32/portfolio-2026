{% block related_menu %}
    {% block related_menu_inner %}
        {% if group is not empty %}
            {% block related_menu_content %}
                <nav class="sidebar__section boxed boxed--subtle" aria-labelledby="related-pages-heading-{{ title|lower|replace({' ':''}) }}">
                    {% block related_menu_content_inner %}
                        {% block related_menu_heading %}
                            <h2 class="sidebar__heading" id="related-pages-heading-{{ title|lower|replace({' ':''}) }}">
                                {{ title }}
                            </h2>
                        {% endblock %}
                        {% block related_menu_links %}
                            <ul class="list list--rich">
                                {% for item in group %}
                                    {% block related_menu_link %}
                                    <li class="list__item">
                                        <a class="list__link" href="{{ item.url }}">
                                            {{ item.title }}
                                        </a>
                                    </li>
                                    {% endblock %}
                                {% endfor %}
                            </ul>
                        {% endblock %}

                    {% endblock related_menu_content_inner %}

                </nav>
            {% endblock related_menu_content %}

        {% endif %}
    {% endblock related_menu_inner %}

{% endblock related_menu %}
