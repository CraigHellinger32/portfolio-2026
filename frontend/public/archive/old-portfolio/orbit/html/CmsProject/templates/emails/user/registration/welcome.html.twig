{% extends 'emails/layout/base.html.twig' %}

{% block main %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
        <tr>
            <td class="content-block" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px; color: #6f6f6f;" valign="top">
                <br><br>{{ getTranslatedString('register-email-body', [app.request.schemeAndHttpHost ~ app.request.baseUrl])|raw }}
            </td>
        </tr>
        <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
            <td class="content-block detail-block" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; padding: 10px; background-color: #f6f6f6; border: 1px solid #e9e9e9; border-top-left-radius: 10px; border-bottom-right-radius: 10px;">
                <table style="width:auto">
                    <tr>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;"><strong style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">{{ getTranslatedString('signin-email-label') }}</strong> </p>
                        </td>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;">{{ user.email }} </p>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;"><strong style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">{{ getTranslatedString('signin-password-label') }}</strong> </p>
                        </td>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;">{{ getTranslatedString('register-email-password-placeholder') }}</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
            <td class="content-block" itemprop="handler" itemscope="" itemtype="http://schema.org/HttpActionHandler" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; text-align:center; font-size: 14px; vertical-align: top; padding: 0 0 20px;">
                <a href="{{ absolute_url(path('user_account_signin')) }}" class="btn-primary" itemprop="url" style="margin: 0; box-sizing: border-box; font-size: 14px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #fff; text-decoration: none; text-transform: capitalize; border: solid #348eda; border-width: 10px 20px; margin-top: 10px; font-weight: bold; text-align: center; cursor: pointer; display: inline-block; border-radius: 5px; line-height: 2em; background-color: #0b89ad; border-color: #0b89ad;">{{ getTranslatedString('sign-in-link-label') }}</a>
            </td>
        </tr>
    </table>
{% endblock %}
