{% set section = 'Image Link' %}

<div class="style-guide__section" id="section--{{ section|lower|replace({' ':'-', '_':'-'}) }}">
    {% include 'partials/atoms/styleguide/text/heading.html.twig' with {
        'section': section
        }
    %}
    <div class="measure">
        {% include 'partials/molecules/image/image_link.html.twig' with {
            'url': imgSrc,
            'alt': imgSrc|image_property('altText')|default(''),
            'link_url': link_url,
            'caption': caption
            }
        %}
    </div>
</div>
