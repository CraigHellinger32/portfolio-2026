{% extends 'emails/layout/base.html.twig' %}

{% block main %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
        <tr>
            <td class="content-block" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px; color: #6f6f6f;" valign="top">
                <p>Hi there,</p>
                <p>A directory entry <b>has been updated</b> on the {{ app.request.schemeAndHttpHost ~ app.request.baseUrl }} website.</p>
            </td>
        </tr>
        <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
            <td class="content-block detail-block" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; padding: 10px; background-color: #f6f6f6; border: 1px solid #e9e9e9; border-top-left-radius: 10px; border-bottom-right-radius: 10px;">
                <table style="width:auto">
                    <tr>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;"><strong style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">Directory:</strong> </p>
                        </td>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;">{{ directory.name }} </p>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;"><strong style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">Entry:</strong> </p>
                        </td>
                        <td>
                            <p style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px; font-weight: normal; margin-bottom: 5px;">{{ entry.title }} </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
{% endblock %}
