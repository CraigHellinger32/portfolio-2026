{% include 'partials/molecules/text/alert.html.twig' with {
    'type': 'warning',
    'title': getTranslatedString('password-required'),
    'summary': ''
    }
%} {# Additional "summary" attribute added above as this throws a Twing error if it's missing #}
{%
    set passwordform = {
        'method' : 'post',
        'controls': [
            {
                'type': 'password',
                'label': getTranslatedString('password-label'),
                'name': 'password',
                'mandatory': true,
                'value': '',
                'autocomplete': false,
            }
        ],
        'primaryAction': {
            'name': 'submitPageLogin',
            'label': getTranslatedString('password-button-label'),
            'type': 'submit'
        }
    }
%}
{% include 'partials/organisms/form/form.html.twig' with {
    'form': passwordform
    }
%}
