{% if rows is empty %}
    {% set rows = 5 %}
{% endif %}
{% if cols is empty %}
    {% set cols = 30 %}
{% endif %}
{% spaceless %}
    <textarea class="form__textarea" 
    name="{{ name }}" 
    id="{{ name }}" 
    rows="{{ rows }}" 
    cols="{{ cols }}"
    placeholder="{{ placeholder }}"
    {% if maxlength %}maxlength="{{ maxlength }}"{% endif %} 
    {% if required %}aria-required="true"{% endif %}>{{ value|raw }}</textarea>
{% endspaceless %}