{% for messages in app.session.flashBag.get('error') %}
    {% if messages is not empty %}
        {% if messages is iterable %}
            {% for message in messages %}
                {% include 'partials/molecules/text/alert.html.twig' with {
                    'type': 'error',
                    'title' : message,
                    'index' : loop.index
                }
                %}
            {% endfor %}
        {% else %}
            {% include 'partials/molecules/text/alert.html.twig' with {
                'type': 'error',
                'title' : messages
            }
            %}
        {% endif %}
    {% endif %}
{% endfor %}
