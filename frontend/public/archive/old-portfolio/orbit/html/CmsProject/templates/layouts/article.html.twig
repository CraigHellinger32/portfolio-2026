{% extends 'layouts/base.html.twig' %}

{% block javascript_metadata %}
    {# <script src="{{ asset('site/js/swfobject.min.js') }}"></script> - purposely leaving swfobject out of orbit #}
{% endblock %}

{% block primary_supplements %}
    {% if page.content.passwordProtected == false and page.content.restricted == false %}
        {% include 'partials/molecules/supplement/supplement.html.twig' with {
            'supplements': page.content.supplements,
            'location': 'sidebar',
            'modifier': 'primary'
            }
        %}
    {% endif %}
{% endblock %}

{% block before_page_content %}
    {% if page.content.passwordProtected == false and page.content.restricted == false %}
        {% include 'partials/molecules/list/list.html.twig' with {
            'type': 'page',
            'title': page.content.title,
            'group': page.content.navigation
            }
        %}
    {% endif %}
{% endblock before_page_content %}

{% block page_content %}
    {% block main %}
        {% block page_alert %}
            {% include 'partials/organisms/alert.html.twig' %}
        {% endblock %}

        {% block page_content_article %}
            {% if page.content.passwordProtected == true %}
                {% include 'partials/organisms/form/password_form.html.twig' %}
            {% elseif page.content.restricted == true %}
                {% include 'partials/atoms/text/restricted_message.html.twig' with {
                    'title': getTranslatedString('privileges-error-message')
                    }
                %}
            {% else %}
                {% include 'partials/organisms/article.html.twig' with {
                    'article': page.content
                    }
                %}
            {% endif %}
        {% endblock page_content_article %}
    {% endblock main %}
{% endblock page_content %}

{% block after_page_content %}
    {% block pagination %}
        {% if page.content.passwordProtected == false and page.content.restricted == false %}
            {% include 'partials/molecules/navigation/pagination.html.twig' with {
                'previous_link': page.content.pagination.previous,
                'next_link': page.content.pagination.next
                }
            %}
        {% endif %}
    {% endblock %}
{% endblock %}

{% block secondary_supplements %}
    {% if page.content.passwordProtected == false and page.content.restricted == false %}
        {% include 'partials/molecules/supplement/supplement.html.twig' with {
            'supplements': page.content.supplements,
            'location': 'below content',
            'modifier': 'secondary'
            }
        %}
    {% endif %}
{% endblock %}
