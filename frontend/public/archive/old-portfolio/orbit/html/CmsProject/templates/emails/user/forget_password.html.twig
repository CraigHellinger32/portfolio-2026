{% extends 'emails/layout/base.html.twig' %}

{% block main %}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
        <tr>
            <td class="content-block" style="font-family: 'Helvetica Neue',Helvetica,Arial,sans-serif; box-sizing: border-box; font-size: 14px; vertical-align: top; margin: 0; padding: 0 0 20px; color: #6f6f6f;" valign="top">
                {% if user.salutation is not empty and user.surname is not empty %}
                    {{ getTranslatedString('password-reset-email-greeting', [user.salutation ~ ' ' ~ user.surname]) }}
                {%  endif %}
                <br><br>{{ getTranslatedString('password-reset-email-body') }}
            </td>
        </tr>
        <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
            <td class="content-block" itemprop="handler" itemscope="" itemtype="http://schema.org/HttpActionHandler" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; text-align:center; font-size: 14px; vertical-align: top; padding: 0 0 20px;">
                <a href="{{ absolute_url(path('user_account_password_reset', { resetCode : user.resetCode })) }}" class="btn-primary" itemprop="url" style="margin: 0; box-sizing: border-box; font-size: 14px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #fff; text-decoration: none; text-transform: capitalize; border: solid #348eda; border-width: 10px 20px; margin-top: 10px; font-weight: bold; text-align: center; cursor: pointer; display: inline-block; border-radius: 5px; line-height: 2em; background-color: #0b89ad; border-color: #0b89ad;">{{ getTranslatedString('password-reset-link') }}</a>
            </td>
        </tr>
        {% if app.request.getClientIp()|length > 0 %}
            <tr style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; font-size: 14px;">
                <td class="content-block" itemprop="handler" itemscope="" itemtype="http://schema.org/HttpActionHandler" style="margin: 0; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; box-sizing: border-box; text-align:center; font-size: 14px; vertical-align: top; padding: 0 0 20px;">
                    <br><p style="color: #99a0aa"><small>{{ getTranslatedString('password-reset-email-ip-statement', [app.request.getClientIp()]) }}</small></p><br>
                </td>
            </tr>
        {% endif %}
    </table>
{% endblock %}
