{% block confirmation_section %}
    {% if element.structure|length > 0 or isTableRow %}
        {% if element.showTitle %}
            {% block confirmation_section_inner %}
                {% block confirmation_section_heading %}
                    <h3 class="list__group-title">{{ element.text|default(sectionTitle) }}</h3>
                {% endblock %}

                {% block confirmation_section_answers_wrap %}
                    <ul class="list list--form-summary form-summary__answers">
                        {% block confirmation_section_answers %}
                            {% for text, answer in element.structure %}
                                {% if answer.structure is defined %}
                                    {% if answer.structure|length > 0 %}
                                        {% if answer.showTitle %}
                                            {% block confirmation_section_answer_section %}
                                                <li class="list__group">
                                                    {% block confirmation_section_answer_section_inner %}
                                                        {% include 'partials/organisms/form/form_confirmation_section.html.twig' with {
                                                            'element': answer,
                                                            'sectionTitle': text
                                                        } only %}
                                                    {% endblock %}
                                                </li>
                                            {% endblock %}
                                        {% else %}
                                            {{ block('confirmation_section_answer_section_inner') }}
                                        {% endif %}
                                    {% endif %}
                                {% elseif answer is iterable %}
                                    {% block confirmation_section_answer_repeatable %}
                                        <li class="list__group">
                                            {% block confirmation_section_answer_repeatable_inner %}
                                                {% include 'partials/organisms/form/form_confirmation_section.html.twig' with {
                                                    'element': {
                                                        'structure': answer,
                                                        'showTitle': true
                                                    },
                                                    'sectionTitle': text
                                                } only %}
                                            {% endblock %}
                                        </li>
                                    {% endblock %}
                                {% else %}
                                    {% block confirmation_section_answer %}
                                        <li class="list__item">
                                            {% include 'partials/organisms/form/form_confirmation_answer.html.twig' with {
                                                'answer': answer,
                                                'question': answer.question,
                                                'type': answer.component
                                            } only %}
                                        </li>
                                    {% endblock %}
                                {% endif %}
                            {% endfor %}
                        {% endblock %}
                    </ul>
                {% endblock %}
            {% endblock %}
        {% else %}
            {{ block('confirmation_section_answers') }}
        {% endif %}
    {% endif %}
{% endblock %}
