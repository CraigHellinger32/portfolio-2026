{% extends 'layouts/'~ (photonEnabled ? '' : 'legacy-') ~'form.html.twig' %}

{% block stylesheet_base %}
    {% block stylesheet_base_xfp %}
        <link rel="stylesheet" type="text/css" href="{{ asset('site/xfp/css/dropzone.css?v=xfp_cb_26') }}" />
    {% endblock %}

    {{ parent() }}
{% endblock %}

{% block javascript_footer %}
    {% block javascript_footer_xfp %}
        {% block javascript_footer_xfp_scripts %}
            <script src="{{ asset('site/xfp/js/src/in-page-branching.js?v=xfp_cb_26') }}"></script>
            <script src="{{ asset('site/xfp/js/src/file-uploads.js?v=xfp_cb_26') }}"></script>
            <script src="{{ asset('site/xfp/js/src/dropzone.js?v=xfp_cb_26') }}"></script>
            <script src="{{ asset('site/xfp/js/src/date-input-polyfill.dist.js?v=xfp_cb_26') }}"></script>
        {% endblock %}

        {% block javasript_footer_xfp_inline %}
            <script>
                var uploads = new FileUploads();
                uploads.init();

                var branching = new InPageBranching();
                branching.init();

                {% if formPage.anchor %}
                    window.location = '#{{ formPage.anchor }}';
                {% endif %}

                document.querySelector('form.form--form-builder').addEventListener('submit', function(ev) {
                    var formTag = document.querySelector('form.form--form-builder');

                    if (formTag.getAttribute('data-submitted') !== 'true') {
                        formTag.setAttribute('data-submitted', 'true');
                        return true;
                    }

                    ev.preventDefault();
                    return false;
                });
            </script>
        {% endblock %}
    {% endblock %}

    {{ parent() }}
{% endblock %}
