{% set parent = question %}

{% for levelNo, level in question.ic.levels %}
    {% block form_ic %}
        <div class="form__level{% if levelNo == (question.ic.total - 1) %} js-is-last-level{% endif %}" id="{{ question.name }}_{{ levelNo }}">
            {% block form_ic_questions %}
                {% for question in level %}

                    {% block form_ic_question %}
                        <div data-secondary="{{ question.secondary }}" class="form__control{% if levelNo < (question.ic.total - 1) or level|length == 15 %} form__control--append{% endif %}"> {# MODIFIED FOR PROTOTYPES #}
                            {% block form_ic_question_inner %}
                                {% block form_ic_question_label %}
                                    <label class="form__label{% if not question.showLabel %} visually-hidden{% endif %}" for="{{ question.name }}">{{ question.label }}</label>
                                {% endblock %}

                                {% block form_ic_question_group %}
                                    <span class="integrated-component">
                                        {% block form_ic_question_template %}
                                            {% include question.template %}
                                        {% endblock %}

                                        {% block form_ic_question_button %}
                                            {% if levelNo < (parent.ic.total - 1) %} {# MODIFIED FOR PROTOTYPES #}
                                                {% block form_ic_question_button_inner %}
                                                    <button type="submit" name="callback" value="{{ { 'action':'ic', 'element': parent.name, 'data': levelNo, 'tableRow': parent.tableRow }|json_encode|e('html_attr') }}" class="button button--secondary btn--lookup">Lookup</button>
                                                {% endblock %}
                                            {% endif %}
                                        {% endblock %}

                                        {% block form_ic_question_error %}
                                            {% if question.error is defined %}
                                                {% block form_ic_question_error_inner %}
                                                    <p class="help-text">{{ question.error }}</p>
                                                {% endblock %}
                                            {% endif %}
                                        {% endblock %}
                                    </span>
                                {% endblock %}
                            {% endblock %}
                        </div>
                    {% endblock %}
                {% endfor %}
            {% endblock %}

            {% block form_ic_last_level %}
                {% if levelNo < (question.ic.total - 1) and level|length > 1 and level|length != 15 %} {# MODIFIED FOR PROTOTYPES #}
                    {% block form_ic_last_level_control %}
                        <div class="form__control">
                            {% block form_ic_last_level_label %}
                                <label class="form__label"></label>
                            {% endblock %}

                            {% block form_ic_last_level_button %}
                                <button type="submit" name="callback" value="{{ { 'action':'ic', 'element': question.name, 'data': levelNo, 'tableRow': parent.tableRow }|json_encode|e('html_attr') }}" class="button button--secondary btn--lookup">Lookup</button>
                            {% endblock %}
                        </div>
                    {% endblock %}
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
{% endfor %}
